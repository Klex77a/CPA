# Upload only runtime source and explicitly selected reports/assets.
# Keep directory rules slashless: the native CLI tests directory path strings.
/*
!api
!public
!src
!server.js
!package.json
!package-lock.json
!vercel.json
!docs
docs/*
!docs/DEMO_SCRIPT.md
!docs/benchmark-results
docs/benchmark-results/*
!docs/benchmark-results/latest.json
!test
test/*
!test/fixtures
test/fixtures/*
!test/fixtures/benchmark-cases.json
!results
results/*
!results/dev
!results/prod
results/dev/*
results/prod/*
!results/dev/results.json
!results/prod/results.json

# Never ship local credentials, caches, private snapshots, or machine settings.
**/.env
**/.env.*
**/*.tmp
**/node_modules
**/.git
**/.vercel
**/.cache
**/.codex
**/.agents
data
tmp
output
test-artifacts
