{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 180,
      "includeFiles": "{server.js,src/**,dist/**,docs/DEMO_SCRIPT.md,docs/benchmark-results/latest.json,test/fixtures/benchmark-cases.json,results/**}"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
