# Скопируйте этот файл в .env и заполните. Файл .env НЕ попадает в Git.

# --- ИИ для оценки (выберите один) ---
# deepseek | gemini | openai | anthropic | mock (демо без ИИ)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Модель (необязательно; по умолчанию deepseek-flash / gemini-3.8-flash / gpt-4o-mini / claude-haiku-5-5)
# LLM_MODEL=deepseek-v4-pro

# --- Данные организаторов ---
# Ссылка «Открыть GET для DEV» со стр. 3 гайда. group_id сервер подставляет сам.
DATA_API_URL=
# Необязательно: разрешить только точные домены страницы записи и CDN, через запятую.
# Без списка сервер всё равно проверяет DNS/IP, блокирует закрытые сети и закрепляет IP соединения.
# Редиректы страницы записи запрещены; указывайте конечный HTTPS URL.
# AUDIO_ALLOWED_HOSTS=recordings.example.com,cdn.example.com

# --- Прочее ---
# Без авторизации приложение предназначено для локального запуска.
HOST=127.0.0.1
# Для отдельного HTML-компонента Dynamics: точные доверенные Origin через запятую.
# По умолчанию доступ браузера разрешён только со страницы самого приложения.
# CORS_ORIGINS=https://your-org.crm.dynamics.com
PORT=3000
# Сколько диалогов оценивать параллельно (у бесплатного Gemini лимит запросов в минуту — держите 2)
CONCURRENCY=2
# Сколько раз оценивать каждый диалог и голосовать большинством: 1 = быстро, 3 = точнее (в 3 раза больше запросов)
SAMPLES=1
# Цена модели за 1 млн токенов в USD (для расчёта стоимости одной оценки)
# PRICE_IN_PER_M=0.3
# PRICE_OUT_PER_M=2.5

# --- Надёжность и время (необязательно) ---
# LLM_TIMEOUT_MS=240000
# LLM_MAX_ATTEMPTS=3
# REPAIR_ATTEMPTS=1
# Для Gemini 3 температуру лучше не задавать (рекомендация Google — значение по умолчанию)
# TEMPERATURE=
# Уровень «размышления» Gemini 3: low | medium | high (не задан — значение модели)
# GEMINI_THINKING_LEVEL=
# Размышление DeepSeek: none (выключить, быстрее и дешевле) | low | high | max (не задан — значение API, размышление включено)
# DEEPSEEK_REASONING_EFFORT=

# --- Vercel: постоянное хранилище и закрытый доступ ---
# На Vercel облачный режим включается автоматически. Локально он нужен только для проверки Postgres.
# CQA_STORAGE_DRIVER=postgres
# CQA_DATABASE_URL=postgresql://... (pooled connection из Neon/Vercel Marketplace)
# CQA_WORKSPACE_ID=midnight-commit
# CQA_ACCESS_USERNAME=midnight
# CQA_ACCESS_PASSWORD= (отдельный длинный пароль для команды)
# Ключ модели и эти значения задавайте серверными Environment Variables Vercel.
# Локальный .env и data/ в деплой не загружаются.
